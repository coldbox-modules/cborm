/**
 * ********************************************************************************
 * Copyright Since 2005 ColdBox Framework by Luis Majano and Ortus Solutions, Corp
 * www.ortussolutions.com
 * ********************************************************************************
 *
 * This interceptor will inspect objects for the 'transactional' annotation and if found,
 * it will wrap the method in a BoxLang transaction. The ORM rides the transaction's connection, so ORM writes
 * commit and roll back with it. This aspect is a self binding aspect for WireBox that registers itself using the
 * two annotations below
 *
 * The transactional annotation can have a value if you are using multi-datasources with ORM.
 * The value of the transactional annotation denotes the dsn.
 *
 * @Author        Luis Majano
 * @Description   A cool annotation based Transaction Aspect for WireBox
 * @classMatcher  any
 * @methodMatcher annotatedWith:transactional
 **/
class implements="coldbox.system.aop.MethodInterceptor" accessors="true" {

	// Dependencies
	property name="log" inject="logbox:logger:{this}";

	/**
	 * Constructor
	 */
	function init(){
		return this;
	}

	/**
	 * The AOP method invocation: runs the method inside a transaction, unless one is already running. BoxLang commits
	 * the transaction at the end, and rolls it back and rethrows when the method throws.
	 *
	 * @invocation The method invocation
	 */
	any function invokeMethod( required invocation ){
		// Already in a transaction: it commits or rolls back this call too
		if ( isInTransaction() ) {
			if ( variables.log.canDebug() ) {
				variables.log.debug(
					"Call to '#arguments.invocation.getTargetName()#.#arguments.invocation.getMethod()#()' already transactioned, just executing it"
				);
			}
			return arguments.invocation.proceed();
		}

		// The transactional annotation can name the datasource
		var datasource = getTransactionalDatasource( arguments.invocation.getMethodMetadata() );
		var results    = null;

		if ( variables.log.canDebug() ) {
			variables.log.debug(
				"Call to '#arguments.invocation.getTargetName()#.#arguments.invocation.getMethod()#()' is now transactioned and begins execution"
			);
		}
		try {
			if ( len( datasource ) ) {
				transaction datasource=datasource {
					results = arguments.invocation.proceed();
				}
			} else {
				transaction {
					results = arguments.invocation.proceed();
				}
			}
		} catch ( Any e ) {
			variables.log.error(
				"An exception ocurred in the AOPed transaction for target: #arguments.invocation.getTargetName()#, method: #arguments.invocation.getMethod()#: #e.message# #e.detail#",
				e
			);
			rethrow;
		}

		// With CFML null semantics a null result removes the variable
		if ( !isNull( results ) ) {
			return results;
		}
	}

	/**
	 * The datasource named by the method's `transactional` annotation, or an empty string for the default one
	 *
	 * @methodMD The method metadata
	 */
	private string function getTransactionalDatasource( required struct methodMD ){
		var value = arguments.methodMD.annotations.transactional ?: ( arguments.methodMD.transactional ?: "" );
		return isSimpleValue( value ) ? trim( value ) : "";
	}

}
