/**
 * Copyright Since 2005 ColdBox Framework by Luis Majano and Ortus Solutions, Corp
 * www.ortussolutions.com
 * ---
 * A helper ORM service that abstracts the bx-orm module (Hibernate 7) behind a friendly API. Use it in its concrete
 * form, as a virtual service for one entity (`VirtualEntityService`), as an active record (`ActiveEntity`), or extend
 * it with your own services.
 *
 * Every method delegates to the bx-orm built-in functions (`entityLoad()`, `ormExecuteQuery()`, `entityCriteria()`,
 * ...), so it works with any bx-orm feature and with the BoxLang `transaction{}` the ORM rides on.
 */
class accessors="true" {

	/**
	 * The name of the cache region to store cached queries, entities, etc.  Defaults to `ORMService.defaultCache`
	 */
	property
		name      ="queryCacheRegion"
		type      ="string"
		default   ="ORMService.defaultCache"
		persistent="false";

	/**
	 * Tells the services to leverage query caching, defaults to false
	 */
	property
		name      ="useQueryCaching"
		type      ="boolean"
		default   ="false"
		persistent="false";

	/**
	 * Bit identifying if ORM event handling is active, defaults to true
	 */
	property
		name      ="eventHandling"
		type      ="boolean"
		default   ="true"
		persistent="false";

	/**
	 * The system ORM event handler to transmit ORM events to.
	 */
	property name="ORMEventHandler" persistent="false";

	/**
	 * The bit that enables automatic transaction demarcation on all save, saveAll, update, delete methods, default is TRUE
	 */
	property
		name      ="useTransactions"
		type      ="boolean"
		default   ="true"
		persistent="false";

	/**
	 * The bit that determines the default return value for list(), createCriteria() and executeQuery() as query or arrays, default is array
	 */
	property
		name      ="defaultAsQuery"
		type      ="boolean"
		default   ="false"
		persistent="false";

	/**
	 * The default datsource to use for all transactions, else we look at arguments or entity itself
	 */
	property
		name      ="datasource"
		type      ="string"
		persistent="false"
		default   ="";

	/**
	 * A LogBox logger prepared for the class
	 */
	property name="logger" persistent="false";

	/**
	 * A WireBox reference
	 */
	property name="wirebox" persistent="false";

	/************************************** CONSTRUCTOR *********************************************/

	/**
	 * Constructor
	 *
	 * @queryCacheRegion The default query cache region to use, by default it uses ORMService.defaultCache
	 * @useQueryCaching  Activate caching or not
	 * @eventHandling    Activate event handling or not
	 * @useTransactions  Use transactions around all crud operations or not
	 * @defaultAsQuery   Return queries or array of objects by default
	 * @datasource       The default datasource to use for this service
	 */
	BaseORMService function init(
		string queryCacheRegion = "ORMService.defaultCache",
		boolean useQueryCaching = false,
		boolean eventHandling   = true,
		boolean useTransactions = true,
		boolean defaultAsQuery  = false,
		string datasource
	){
		// setup local properties
		variables.queryCacheRegion = arguments.queryCacheRegion;
		variables.useQueryCaching  = arguments.useQueryCaching;
		variables.eventHandling    = arguments.eventHandling;
		variables.useTransactions  = arguments.useTransactions;
		variables.defaultAsQuery   = arguments.defaultAsQuery;
		// WireBox and the logger are resolved on first use (getWireBox(), getLogger()): Hibernate creates entities
		// (ActiveEntity) while the ORM starts, before ColdBox has put WireBox in the application scope.

		// Datasource
		if ( isNull( arguments.datasource ) ) {
			var appMD = getApplicationMetadata();
			if ( appMD.keyExists( "ormsettings" ) && appMD.ormsettings.keyExists( "datasource" ) ) {
				variables.datasource = appMD.ormsettings.datasource;
			} else {
				variables.datasource = appMD.datasource ?: "";
			}
		} else {
			variables.datasource = arguments.datasource;
		}

		return this;
	}

	/*****************************************************************************************/
	/************************************ UTILITY METHODS ************************************/
	/*****************************************************************************************/

	/**
	 * The WireBox injector, taken from the application scope on first use
	 *
	 * @return coldbox.system.ioc.Injector
	 */
	function getWireBox(){
		if ( isNull( variables.wirebox ) ) {
			variables.wirebox = application.wirebox;
		}
		return variables.wirebox;
	}

	/**
	 * A LogBox logger for this service, created on first use
	 *
	 * @return coldbox.system.logging.Logger
	 */
	function getLogger(){
		if ( isNull( variables.logger ) ) {
			variables.logger = getWireBox().getLogBox().getLogger( this );
		}
		return variables.logger;
	}

	/**
	 * Functional construct for if statements operating over this service and family of services
	 *
	 * The success/failure closures accept the service as the first argument
	 * <pre>
	 * when( true|false, ( service )=> {}, ( service )=> {} )
	 * </pre>
	 *
	 * @target  The boolean evaluator, it has to evaluate to true or false
	 * @success The closure/lambda to execute if the boolean value is true
	 * @failure The closure/lambda to execute if the boolean value is false
	 *
	 * @return Returns the same object so you can further use chaining
	 */
	BaseORMService function when(
		required boolean target,
		required success,
		failure
	){
		if ( arguments.target ) {
			arguments.success( this );
		} else if ( !isNull( arguments.failure ) ) {
			arguments.failure( this );
		}
		return this;
	}

	/**
	 * Returns the cborm ORM event handler, which announces the ORM events as ColdBox interception points.
	 *
	 * @return cborm.models.EventHandler
	 */
	function getORMEventHandler(){
		if ( !structKeyExists( variables, "ORMEventHandler" ) || isNull( variables.ORMEventHandler ) ) {
			variables.ORMEventHandler = new cborm.models.EventHandler();
		}
		return variables.ORMEventHandler;
	}

	/**
	 * Lazy loading the dynamic methods processor
	 *
	 * @return cborm.models.util.DynamicProcessor
	 */
	function getDynamicProcessor(){
		if ( !structKeyExists( variables, "dynamicProcessor" ) || isNull( variables.dynamicProcessor ) ) {
			variables.dynamicProcessor = getWireBox().getInstance( "cborm.models.util.DynamicProcessor" );
		}

		return variables.dynamicProcessor;
	}

	/**
	 * Normalize an id, a list of ids or an array of ids into an array of ids.
	 * bx-orm and Hibernate 7 convert id values to the entity's id type themselves, so no type casting is done.
	 *
	 * @deprecated Ids no longer need casting; kept for compatibility
	 * @entity     The entity name or entity object (unused)
	 * @id         The id, list of ids or array of ids
	 *
	 * @return An array of ids
	 */
	any function idCast( required entity, required id ){
		if ( isSimpleValue( arguments.id ) ) {
			return listToArray( arguments.id );
		}
		return isArray( arguments.id ) ? arguments.id : [ arguments.id ];
	}

	/**
	 * Returns the value as is: bx-orm and Hibernate 7 convert query values to the property's type themselves.
	 *
	 * @deprecated Values no longer need casting; kept for compatibility
	 * @entity       The entity name or entity object (unused)
	 * @propertyName The property name (unused)
	 * @value        The property value
	 */
	any function autoCast(
		required entity,
		required propertyName,
		required value
	){
		return arguments.value;
	}

	/**
	 * Normalize an id, list of ids or array of ids into an array of ids.
	 *
	 * @deprecated In favor of `idCast()`, which is no longer needed
	 * @entityName The entity name
	 * @id         The id value to convert
	 */
	any function convertIdValueToJavaType( required entityName, required id ){
		return idCast( entity = arguments.entityName, id = arguments.id );
	}

	/**
	 * Returns the value as is.
	 *
	 * @deprecated   In favor of `autoCast()`, which is no longer needed
	 * @entityName   The entity name or entity object
	 * @propertyName The property name
	 * @value        The property value
	 */
	any function convertValueToJavaType(
		required entityName,
		required propertyName,
		required value
	){
		return arguments.value;
	}

	/*****************************************************************************************/
	/************************************ RETRIEVAL METHODS **********************************/
	/*****************************************************************************************/

	/**
	 * List all of the instances of the passed in entity class name. You can pass in several optional arguments like
	 * a struct of filtering criteria, a sortOrder string, offset, max, ignorecase, and timeout.
	 *
	 * Caching for the list is based on the useQueryCaching class property and the cachename property is based on
	 * the queryCacheRegion class property.
	 *
	 * @entityName The entity to list on
	 * @criteria   A struct of filtering criteria to apply to the where clause
	 * @sortOrder  The sorting order of the result
	 * @offset     Used for pagination
	 * @max        The max number of records to retrieve
	 * @timeout    A DB timeout for this query
	 * @ignoreCase Sort text properties case-insensitively
	 * @asQuery    The return format as either a query or array of objects
	 * @asStream   Return a Java stream that reads the entities from the database as it is consumed
	 * @options    More bx-orm `entityLoad()` options, e.g. `{ readOnly : true }`
	 *
	 * @return An array of entities, a query or a Java stream
	 */
	any function list(
		required string entityName,
		struct criteria    = structNew(),
		string sortOrder   = "",
		numeric offset     = 0,
		numeric max        = 0,
		numeric timeout    = 0,
		boolean ignoreCase = false,
		boolean asQuery    = getDefaultAsQuery(),
		boolean asStream   = false,
		struct options     = {}
	){
		var loadOptions = pagingOptions( arguments.offset, arguments.max, arguments.timeout );

		// Sort Order Case
		if ( len( trim( arguments.sortOrder ) ) ) {
			loadOptions.ignoreCase = arguments.ignoreCase;
		}
		if ( arguments.asStream ) {
			loadOptions.asStream = true;
		}
		loadOptions.append( arguments.options, true );

		var results = entityLoad(
			arguments.entityName,
			arguments.criteria,
			arguments.sortOrder,
			loadOptions
		);

		if ( arguments.asQuery && !arguments.asStream ) {
			return entityToQuery( results );
		}
		return results;
	}

	/**
	 * Allows the execution of HQL queries using several nice arguments and returns either an array of entities or a query as specified by the asQuery argument.
	 * The params filtering can be using named or positional.
	 *
	 * @query      The HQL Query to execute
	 * @params     A struct or array of query params
	 * @offset     Used for pagination
	 * @max        The max number of records to retrieve
	 * @timeout    A DB timeout for this query
	 * @ignoreCase Ignored, kept for compatibility: use `lower()` in the HQL for case-insensitive comparisons
	 * @asQuery    The return format as either a query or array of objects
	 * @unique     Return array or a unique record, defaults to array
	 * @datasource The datasource to use
	 * @asStream   Return a Java stream that reads the rows from the database as it is consumed
	 * @options    More bx-orm `ormExecuteQuery()` options, e.g. `{ readOnly : true, lock : "write", uniqueFirst : true }`
	 *
	 * @return An array, a query, a Java stream, a single entity or value (unique), or the row count of an update/delete
	 */
	any function executeQuery(
		required string query,
		any params         = structNew(),
		numeric offset     = 0,
		numeric max        = 0,
		numeric timeout    = 0,
		boolean ignorecase = false,
		boolean asQuery    = getDefaultAsQuery(),
		boolean unique     = false,
		string datasource  = "",
		boolean asStream   = false,
		struct options     = {}
	){
		var queryOptions = pagingOptions( arguments.offset, arguments.max, arguments.timeout );

		if ( len( arguments.datasource ) ) {
			queryOptions.datasource = arguments.datasource;
		} else if ( len( getDatasource() ) ) {
			queryOptions.datasource = getDatasource();
		}
		if ( arguments.asStream ) {
			queryOptions.asStream = true;
		}
		queryOptions.append( arguments.options, true );

		// process interception
		if ( getEventHandling() ) {
			getORMEventHandler()
				.getEventManager()
				.announce(
					"beforeOrmExecuteQuery",
					{
						"query"   : arguments.query,
						"params"  : arguments.params,
						"unique"  : arguments.unique,
						"options" : queryOptions
					}
				);
		}

		var results = ormExecuteQuery(
			arguments.query,
			arguments.params,
			arguments.unique,
			queryOptions
		);

		// process interception
		if ( getEventHandling() ) {
			getORMEventHandler()
				.getEventManager()
				.announce(
					"afterOrmExecuteQuery",
					{
						"query"   : arguments.query,
						"params"  : arguments.params,
						"unique"  : arguments.unique,
						"options" : queryOptions,
						"results" : results ?: null
					}
				);
		}

		// A unique query found nothing
		if ( isNull( results ) ) {
			return arguments.asQuery ? queryNew( "" ) : null;
		}

		// Streams, counts, update/delete row counts and single values are returned as they are
		if ( arguments.asStream || isSimpleValue( results ) ) {
			return results;
		}

		return arguments.asQuery ? entityToQuery( results ) : results;
	}

	/**
	 * Get an entity using a primary key, if the id is not found this method throws an EntityNotFound Exception
	 *
	 * @entityName The name of the entity to retrieve
	 * @id         The primary key
	 * @options    bx-orm `entityLoadByPK()` options: `lock`, `timeout`, `skipLocked`, `readOnly`
	 *
	 * @throws EntityNotFound
	 */
	any function getOrFail(
		required string entityName,
		required any id,
		struct options = {}
	){
		var result = this.get(
			entityName = arguments.entityName,
			id         = arguments.id,
			returnNew  = false,
			options    = arguments.options
		);
		if ( isNull( result ) ) {
			throw(
				message      = "No entity found for ID #isSimpleValue( arguments.id ) ? arguments.id : serializeJSON( arguments.id )#",
				type         = "EntityNotFound",
				extendedinfo = arguments.entityName
			);
		}
		return result;
	}

	/**
	 * Get an entity using a primary key, if the id is not found this method returns null, if the id=0 or blank it returns a new entity.
	 *
	 * @entityName The name of the entity to retrieve
	 * @id         An optional primary key to use to retrieve the entity, if the id is `0` or `empty` it will return a new unloaded entity
	 * @returnNew  By default if the primary key is 0 or empty it returns a new unloaded entity, if false, then always null
	 * @options    bx-orm `entityLoadByPK()` options: `lock`, `timeout`, `skipLocked`, `readOnly`
	 *
	 * @return Requested entity, new entity or `null`
	 */
	any function get(
		required string entityName,
		required any id,
		boolean returnNew = true,
		struct options    = {}
	){
		// check if id exists so entityLoad does not throw error
		if ( !isSimpleValue( arguments.id ) || len( arguments.id ) ) {
			var oEntity = arguments.options.isEmpty()
			 ? entityLoadByPK( arguments.entityName, arguments.id )
			 : entityLoadByPK( arguments.entityName, arguments.id, arguments.options );
			if ( !isNull( oEntity ) ) {
				return oEntity;
			}
		}

		// Convenience new entity when the id is 0 or empty
		if ( arguments.returnNew && isSimpleValue( arguments.id ) && ( arguments.id == 0 || !len( arguments.id ) ) ) {
			return this.new( entityName = arguments.entityName );
		}
		return null;
	}

	/**
	 * Retrieve all the instances from the passed in entity name using the id argument if specified.
	 * You can also use the properties argument so this method can return to you array of structs instead of array of objects.
	 * The property list must include the `as` alias if not you will get positional keys.
	 * Example: properties="catID as id, category as category, role as role"
	 *
	 * @entityName The entity to get
	 * @id         The id or a list/array of Ids to retrieve; a struct or array of structs for a composite id
	 * @sortOrder  The sorting of the returning array, defaults to the entity's `defaultSort` or natural sorting
	 * @readOnly   Return full or read only entities, defaults to false
	 * @properties If passed, you can retrieve an array of properties of the entity instead of the entire entity.  Make sure you add aliases to the properties: Ex: 'catId as id'
	 * @asStream   Return a Java stream that reads the entities from the database as it is consumed
	 *
	 * @return An array of entities (or structs when `properties` is given), or a Java stream
	 */
	any function getAll(
		required string entityName,
		any id,
		string sortOrder = "",
		boolean readOnly = false,
		string properties,
		boolean asStream = false
	){
		// Projections: select new map( ... ) with the ids bound and the sort order validated
		if ( !isNull( arguments.properties ) ) {
			var hql     = "SELECT new map( #arguments.properties# ) FROM #arguments.entityName#";
			var params  = {};
			var options = { "readOnly" : arguments.readOnly, "asStream" : arguments.asStream };
			if ( !isNull( arguments.id ) ) {
				hql &= " WHERE #singleIdProperty( arguments.entityName, "getAll( properties )" )# in (:idlist)";
				params[ "idlist" ] = { value : idArray( arguments.id ), list : true };
			}
			if ( len( arguments.sortOrder ) ) {
				hql &= " ORDER BY #getDynamicProcessor().validateSortOrder( arguments.sortOrder )#";
			}
			if ( getUseQueryCaching() ) {
				options.cacheName = getQueryCacheRegion();
				options.cacheable = true;
			}
			return ormExecuteQuery( hql, params, false, options );
		}

		var c = entityCriteria( arguments.entityName );
		if ( !isNull( arguments.id ) ) {
			whereIds( c, arguments.entityName, arguments.id );
		}
		// order() validates each property, so the sort order cannot inject HQL
		if ( len( trim( arguments.sortOrder ) ) ) {
			c.order( arguments.sortOrder );
		}
		if ( arguments.readOnly ) {
			c.readOnly( true );
		}
		if ( getUseQueryCaching() ) {
			c.cache( true, getQueryCacheRegion() );
		}
		if ( arguments.asStream ) {
			c.asStream();
		}
		return c.list();
	}

	/**
	 * Finds and returns the first result for the given query or throws an exception if not found,
	 * this method delegates to the `findIt()` method
	 *
	 * @query      The HQL Query to execute
	 * @params     A struct or array of query params
	 * @timeout    A DB timeout for this query
	 * @ignoreCase Ignored, kept for compatibility
	 * @datasource The datasource to use
	 * @options    More bx-orm `ormExecuteQuery()` options
	 *
	 * @throws EntityNotFound
	 */
	any function findOrFail(
		required string query,
		any params         = structNew(),
		numeric timeout    = 0,
		boolean ignoreCase = false,
		string datasource  = getDatasource(),
		struct options     = {}
	){
		var result = findIt( argumentCollection = arguments );
		if ( isNull( result ) ) {
			throw( message = "No entity found", type = "EntityNotFound" );
		}
		return result;
	}

	/**
	 * Finds and returns the first result for the given query or null if no entity was found.
	 * You can either use the query and params combination
	 *
	 * @query      The HQL Query to execute
	 * @params     A struct or array of query params
	 * @timeout    A DB timeout for this query
	 * @ignoreCase Ignored, kept for compatibility
	 * @datasource The datasource to use
	 * @options    More bx-orm `ormExecuteQuery()` options
	 *
	 * @return The first result or null
	 */
	any function findIt(
		required string query,
		any params         = structNew(),
		numeric timeout    = 0,
		boolean ignoreCase = false,
		string datasource  = getDatasource(),
		struct options     = {}
	){
		// The first row, even when several match
		arguments.unique  = true;
		arguments.asQuery = false;
		arguments.options = structCopy( arguments.options ).append( { "uniqueFirst" : true } );

		return executeQuery( argumentCollection = arguments );
	}

	/**
	 * Find all/single entities by example
	 *
	 * @example The example entity
	 * @unique  Unique or array of entities (default)
	 */
	any function findByExample( any example, boolean unique = false ){
		return entityLoadByExample( arguments.example, arguments.unique );
	}

	/**
	 * Find all entities for the specified HQL query and accompanied params.
	 *
	 * @query      The HQL Query to execute
	 * @params     A struct or array of query params
	 * @offset     Used for pagination
	 * @max        The max number of records to retrieve
	 * @timeout    A DB timeout for this query
	 * @ignoreCase Ignored, kept for compatibility
	 * @datasource The datasource to use
	 * @asStream   Return a Java stream that reads the rows from the database as it is consumed
	 * @options    More bx-orm `ormExecuteQuery()` options
	 *
	 * @return An array of entities or a Java stream
	 */
	any function findAll(
		string query,
		any params         = structNew(),
		numeric offset     = 0,
		numeric max        = 0,
		numeric timeout    = 0,
		boolean ignoreCase = false,
		string datasource,
		boolean asStream = false,
		struct options   = {}
	){
		arguments.asQuery = false;
		return executeQuery( argumentCollection = arguments );
	}

	/**
	 * Find one entity (or null if not found) according to a criteria structure. More than one match is an error
	 * (`orm.query.nonUnique`); pass `{ uniqueFirst : true }` as options to take the first one instead.
	 *
	 * @entityName The entity to search for
	 * @criteria   The filtering criteria to search for.
	 * @options    More bx-orm `entityLoad()` options, e.g. `{ uniqueFirst : true, readOnly : true }`
	 *
	 * @return The entity or null
	 */
	any function findWhere(
		required string entityName,
		struct criteria = {},
		struct options  = {}
	){
		var loadOptions = { "unique" : true };
		if ( getUseQueryCaching() ) {
			loadOptions.cacheName = getQueryCacheRegion();
			loadOptions.cacheable = true;
		}
		loadOptions.append( arguments.options, true );
		return entityLoad( arguments.entityName, arguments.criteria, loadOptions );
	}

	/**
	 * Find one entity according to a criteria structure, or throw an `EntityNotFound` exception when none matches
	 *
	 * @entityName The entity to search for
	 * @criteria   The filtering criteria to search for.
	 * @options    More bx-orm `entityLoad()` options, e.g. `{ uniqueFirst : true }`
	 *
	 * @return The entity
	 *
	 * @throws EntityNotFound
	 */
	any function findWhereOrFail(
		required string entityName,
		struct criteria = {},
		struct options  = {}
	){
		var result = findWhere( argumentCollection = arguments );
		if ( isNull( result ) ) {
			throw(
				message      = "No #arguments.entityName# entity found for the given criteria",
				type         = "EntityNotFound",
				extendedinfo = arguments.entityName
			);
		}
		return result;
	}

	/**
	 * The first entity matching a criteria structure, or a new (unsaved) one populated with the criteria and the extra
	 * properties. The new entity is autowired and announces `ORMPostNew`, like `new()`.
	 *
	 * @entityName The entity to search for
	 * @criteria   The filtering criteria to search for, also used to populate a new entity
	 * @properties Extra properties to populate a new entity with; not used for the search
	 *
	 * @return The found or new entity
	 */
	any function firstOrNew(
		required string entityName,
		struct criteria   = {},
		struct properties = {}
	){
		var entity = findWhere(
			entityName = arguments.entityName,
			criteria   = arguments.criteria,
			options    = { "uniqueFirst" : true }
		);
		if ( !isNull( entity ) ) {
			return entity;
		}
		return this.new(
			entityName = arguments.entityName,
			properties = structCopy( arguments.criteria ).append( arguments.properties, true )
		);
	}

	/**
	 * The first entity matching a criteria structure, or a new one populated with the criteria and the extra
	 * properties and saved with `save()`.
	 *
	 * @entityName    The entity to search for
	 * @criteria      The filtering criteria to search for, also used to populate a new entity
	 * @properties    Extra properties to populate a new entity with; not used for the search
	 * @flush         Flush the new entity right away
	 * @transactional Wrap the save in a transaction, defaults to `useTransactions`
	 *
	 * @return The found or new, saved entity
	 */
	any function firstOrCreate(
		required string entityName,
		struct criteria       = {},
		struct properties     = {},
		boolean flush         = false,
		boolean transactional = getUseTransactions()
	){
		var entity = findWhere(
			entityName = arguments.entityName,
			criteria   = arguments.criteria,
			options    = { "uniqueFirst" : true }
		);
		if ( !isNull( entity ) ) {
			return entity;
		}
		return save(
			entity = this.new(
				entityName = arguments.entityName,
				properties = structCopy( arguments.criteria ).append( arguments.properties, true )
			),
			flush         = arguments.flush,
			transactional = arguments.transactional
		);
	}

	/**
	 * Find all entities according to criteria structure
	 *
	 * @entityName The entity to search for
	 * @criteria   The filtering criteria to search for.
	 * @sortOrder  The sorting order
	 * @ignoreCase Sort text properties case-insensitively
	 * @timeout    A DB timeout for this query
	 * @asStream   Return a Java stream that reads the entities from the database as it is consumed
	 * @options    More bx-orm `entityLoad()` options
	 *
	 * @return An array of entities or a Java stream
	 */
	any function findAllWhere(
		required string entityName,
		struct criteria    = {},
		string sortOrder   = "",
		boolean ignoreCase = false,
		numeric timeout    = 0,
		boolean asStream   = false,
		struct options     = {}
	){
		var loadOptions = pagingOptions( 0, 0, arguments.timeout );
		loadOptions.ignorecase = arguments.ignoreCase;
		if ( arguments.asStream ) {
			loadOptions.asStream = true;
		}
		loadOptions.append( arguments.options, true );

		return entityLoad(
			arguments.entityName,
			arguments.criteria,
			arguments.sortOrder,
			loadOptions
		);
	}

	/**
	 * Get a reference (proxy) to an entity by id without loading it: no SELECT runs until a property other than the id
	 * is read. Great for setting associations.
	 *
	 * @entityName The entity name
	 * @id         The id
	 *
	 * @return The entity reference
	 */
	any function getReference( required string entityName, required any id ){
		return entityGetReference( arguments.entityName, arguments.id );
	}

	/**
	 * Lock an entity's row in the database until the current transaction ends. Must run inside a `transaction{}`.
	 *
	 * @entity  The entity to lock
	 * @mode    The lock mode: read, write or force
	 * @options bx-orm `entityLock()` options: `timeout` (seconds) and `skipLocked`
	 *
	 * @return The entity
	 */
	any function lock(
		required any entity,
		string mode    = "write",
		struct options = {}
	){
		entityLock( arguments.entity, arguments.mode, arguments.options );
		return arguments.entity;
	}

	/**
	 * Run a closure with every entity it loads read-only: they are not dirty-checked and their changes are never saved.
	 *
	 * @callback The closure to run
	 *
	 * @return What the closure returns
	 */
	any function readOnly( required callback ){
		return ormReadOnly( arguments.callback );
	}

	/*****************************************************************************************/
	/************************************ CREATION METHODS ***********************************/
	/*****************************************************************************************/

	/**
	 * Return a null value
	 */
	function nullValue(){
		return null;
	}

	/**
	 * Get a new entity object by entity name and you can pass in the properties structre also to bind the entity with properties
	 *
	 * The entity is autowired, populated and then the `ORMPostNew` interception is announced (when event handling is on).
	 *
	 * @entityName           The entity to create
	 * @properties           The structure of data to populate the entity with. By default we will inspect for many-to-one, one-to-many and many-to-many relationships and compose them for you.
	 * @composeRelationships Automatically attempt to compose relationships from the incoming properties memento
	 * @nullEmptyInclude     A list of keys to NULL when empty
	 * @nullEmptyExclude     A list of keys to NOT NULL when empty
	 * @ignoreEmpty          Ignore empty values on populations, great for ORM population
	 * @include              A list of keys to include in the population from the incoming properties memento
	 * @exclude              A list of keys to exclude in the population from the incoming properties memento
	 * @ignoreTargetLists    Ignore target lists during population
	 *
	 * @return The new entity object
	 */
	any function new(
		required string entityName,
		struct properties            = structNew(),
		boolean composeRelationships = true,
		nullEmptyInclude             = "",
		nullEmptyExclude             = "",
		boolean ignoreEmpty          = false,
		include                      = "",
		exclude                      = "",
		boolean ignoreTargetLists    = false
	){
		var eventHandler = getORMEventHandler();

		// entityNew() fires bx-orm's own postNew event; the cborm handler skips it while this counter is above zero so
		// ORMPostNew is announced once, below, after the entity is autowired and populated. A counter, not a flag, so a
		// new() nested in an entity's own postNew() does not end the outer one's skip early.
		request[ "cbormEntityNewInProgress" ] = ( request.cbormEntityNewInProgress ?: 0 ) + 1;
		try {
			var newEntity = entityNew( arguments.entityName );
		} finally {
			request.cbormEntityNewInProgress--;
			if ( request.cbormEntityNewInProgress <= 0 ) {
				request.delete( "cbormEntityNewInProgress" );
			}
		}

		// Build and autowire
		var entity = eventHandler.processEntityInjection( entityName: arguments.entityName, entity: newEntity );

		// Population of properties
		if ( NOT structIsEmpty( arguments.properties ) ) {
			populate(
				target               = entity,
				memento              = arguments.properties,
				composeRelationships = arguments.composeRelationships,
				nullEmptyInclude     = arguments.nullEmptyInclude,
				nullEmptyExclude     = arguments.nullEmptyExclude,
				ignoreEmpty          = arguments.ignoreEmpty,
				include              = arguments.include,
				exclude              = arguments.exclude,
				ignoreTargetLists    = arguments.ignoreTargetLists
			);
		}

		// Event Handling? If enabled, call the postNew() interception
		if ( getEventHandling() ) {
			eventHandler.postNew( entity, arguments.entityName );
		}

		return entity;
	}

	/**
	 * Create a virtual abstract service for a specfic entity
	 *
	 * @entityname       The name of the entity to root this service with
	 * @queryCacheRegion The name of the query cache region if using caching, defaults to `#arguments.entityName#.defaultVSCache`
	 * @useQueryCaching  Activate query caching, defaults to false
	 * @eventHandling    Activate event handling, defaults to true
	 * @useTransactions  Activate transaction blocks on calls, defaults to true
	 * @defaultAsQuery   Return query or array of objects on list(), executeQuery(), criteriaQuery(), defaults to true
	 * @datasource       THe datsource name to be used for the rooted entity, if not we use the default datasource
	 *
	 * @return cborm.models.VirtualEntityService
	 */
	any function createService(
		required string entityname,
		string queryCacheRegion = getQueryCacheRegion(),
		boolean useQueryCaching = getUseQueryCaching(),
		boolean eventHandling   = getEventHandling(),
		boolean useTransactions = getUseTransactions(),
		boolean defaultAsQuery  = getDefaultAsQuery(),
		string datasource       = getDatasource()
	){
		return new cborm.models.VirtualEntityService( argumentCollection = arguments );
	}

	/*****************************************************************************************/
	/********************************* POPULATION METHODS ************************************/
	/*****************************************************************************************/

	/**
	 * Populate/bind an entity's properties and relationships from an incoming structure or map of flat data.
	 *
	 * @target               The entity to populate
	 * @memento              The map/struct to populate the entity with
	 * @scope                Use scope injection instead of setter injection, no need of setters, just tell us what scope to inject to
	 * @trustedSetter        Do not check if the setter exists, just call it, great for usage with onMissingMethod() and virtual properties
	 * @include              A list of keys to include in the population ONLY
	 * @exclude              A list of keys to exclude from the population
	 * @ignoreEmpty          Ignore empty values on populations, great for ORM population
	 * @nullEmptyInclude     A list of keys to NULL when empty
	 * @nullEmptyExclude     A list of keys to NOT NULL when empty
	 * @composeRelationships Automatically attempt to compose relationships from the incoming properties memento
	 * @ignoreTargetLists    Ignore target lists during population
	 *
	 * @return The populated entity
	 */
	any function populate(
		required any target,
		required struct memento,
		string scope                 = "",
		boolean trustedSetter        = false,
		string include               = "",
		string exclude               = "",
		boolean ignoreEmpty          = false,
		string nullEmptyInclude      = "",
		string nullEmptyExclude      = "",
		boolean composeRelationships = true,
		boolean ignoreTargetLists    = false
	){
		return getObjectPopulator().populateFromStruct( argumentCollection = arguments );
	}

	/**
	 * Simple map to property population for entities with structure key prefixes
	 *
	 * @target               The entity to populate
	 * @memento              The map/struct to populate the entity with
	 * @scope                Use scope injection instead of setter injection, no need of setters, just tell us what scope to inject to
	 * @trustedSetter        Do not check if the setter exists, just call it, great for usage with onMissingMethod() and virtual properties
	 * @include              A list of keys to include in the population ONLY
	 * @exclude              A list of keys to exclude from the population
	 * @ignoreEmpty          Ignore empty values on populations, great for ORM population
	 * @nullEmptyInclude     A list of keys to NULL when empty
	 * @nullEmptyExclude     A list of keys to NOT NULL when empty
	 * @composeRelationships Automatically attempt to compose relationships from the incoming properties memento
	 * @prefix               The prefix used to filter, Example: 'user' would apply to the following formfield: 'user_id' and 'user_name' but not 'address_id'
	 * @ignoreTargetLists    Ignore target lists during population
	 *
	 * @return The populated entity
	 */
	any function populateWithPrefix(
		required any target,
		required struct memento,
		string scope                 = "",
		boolean trustedSetter        = false,
		string include               = "",
		string exclude               = "",
		boolean ignoreEmpty          = false,
		string nullEmptyInclude      = "",
		string nullEmptyExclude      = "",
		boolean composeRelationships = true,
		required string prefix,
		boolean ignoreTargetLists = false
	){
		return getObjectPopulator().populateFromStructWithPrefix( argumentCollection = arguments );
	}

	/**
	 * Populate from JSON, for argument definitions look at the populate method
	 *
	 * @target               The entity to populate
	 * @jsonString           The Json string to use for population
	 * @scope                Use scope injection instead of setter injection, no need of setters, just tell us what scope to inject to
	 * @trustedSetter        Do not check if the setter exists, just call it, great for usage with onMissingMethod() and virtual properties
	 * @include              A list of keys to include in the population ONLY
	 * @exclude              A list of keys to exclude from the population
	 * @ignoreEmpty          Ignore empty values on populations, great for ORM population
	 * @nullEmptyInclude     A list of keys to NULL when empty
	 * @nullEmptyExclude     A list of keys to NOT NULL when empty
	 * @composeRelationships Automatically attempt to compose relationships from the incoming properties memento
	 * @ignoreTargetLists    Ignore target lists during population
	 *
	 * @return The populated entity
	 */
	any function populateFromJson(
		required any target,
		required string jsonString,
		string scope                 = "",
		boolean trustedSetter        = false,
		string include               = "",
		string exclude               = "",
		boolean ignoreEmpty          = false,
		string nullEmptyInclude      = "",
		string nullEmptyExclude      = "",
		boolean composeRelationships = true,
		boolean ignoreTargetLists    = false
	){
		return getObjectPopulator().populateFromJSON( argumentCollection = arguments );
	}

	/**
	 * Populate from XML, for argument definitions look at the populate method
	 *
	 * @target               The entity to populate
	 * @xml                  The XML string or packet or XML object to populate from
	 * @root                 The XML root element to start from
	 * @scope                Use scope injection instead of setter injection, no need of setters, just tell us what scope to inject to
	 * @trustedSetter        Do not check if the setter exists, just call it, great for usage with onMissingMethod() and virtual properties
	 * @include              A list of keys to include in the population ONLY
	 * @exclude              A list of keys to exclude from the population
	 * @ignoreEmpty          Ignore empty values on populations, great for ORM population
	 * @nullEmptyInclude     A list of keys to NULL when empty
	 * @nullEmptyExclude     A list of keys to NOT NULL when empty
	 * @composeRelationships Automatically attempt to compose relationships from the incoming properties memento
	 * @ignoreTargetLists    Ignore target lists during population
	 *
	 * @return The populated entity
	 */
	any function populateFromXml(
		required any target,
		required string xml,
		string root                  = "",
		string scope                 = "",
		boolean trustedSetter        = false,
		string include               = "",
		string exclude               = "",
		boolean ignoreEmpty          = false,
		string nullEmptyInclude      = "",
		string nullEmptyExclude      = "",
		boolean composeRelationships = true,
		boolean ignoreTargetLists    = false
	){
		return getObjectPopulator().populateFromXML( argumentCollection = arguments );
	}

	/**
	 * Populate from Query, for argument definitions look at the populate method
	 *
	 * @target               The entity to populate
	 * @qry                  The query to use for population
	 * @rowNumber            The row number to use for population
	 * @scope                Use scope injection instead of setter injection, no need of setters, just tell us what scope to inject to
	 * @trustedSetter        Do not check if the setter exists, just call it, great for usage with onMissingMethod() and virtual properties
	 * @include              A list of keys to include in the population ONLY
	 * @exclude              A list of keys to exclude from the population
	 * @ignoreEmpty          Ignore empty values on populations, great for ORM population
	 * @nullEmptyInclude     A list of keys to NULL when empty
	 * @nullEmptyExclude     A list of keys to NOT NULL when empty
	 * @composeRelationships Automatically attempt to compose relationships from the incoming properties memento
	 * @ignoreTargetLists    Ignore target lists during population
	 *
	 * @return The populated entity
	 */
	any function populateFromQuery(
		required any target,
		required any qry,
		numeric rowNumber            = 1,
		string scope                 = "",
		boolean trustedSetter        = false,
		string include               = "",
		string exclude               = "",
		boolean ignoreEmpty          = false,
		string nullEmptyInclude      = "",
		string nullEmptyExclude      = "",
		boolean composeRelationships = true,
		boolean ignoreTargetLists    = false
	){
		return getObjectPopulator().populateFromQuery( argumentCollection = arguments );
	}

	/**
	 * Get access to the object populator objet
	 *
	 * @return coldbox.system.core.dynamic.ObjectPopulator
	 */
	function getObjectPopulator(){
		if ( structKeyExists( variables, "objectPopulator" ) && !isNull( variables.objectPopulator ) ) {
			return variables.objectPopulator;
		}
		variables.objectPopulator = getWireBox().getObjectPopulator();
		return variables.objectPopulator;
	}

	/*****************************************************************************************/
	/********************************* ENTITY UTILITY METHODS ********************************/
	/*****************************************************************************************/

	/**
	 * Merge an entity or array of entities back into a session
	 *
	 * @entity A single or an array of entities to re-merge
	 *
	 * @return Same entity if one passed, array if an array of entities passed.
	 */
	any function merge( required any entity ){
		if ( !isArray( arguments.entity ) ) {
			return entityMerge( arguments.entity );
		}

		var aReturns = [];
		for ( var thisObject in arguments.entity ) {
			arrayAppend( aReturns, entityMerge( thisObject ) );
		}

		return aReturns;
	}

	/**
	 * Refresh the state of an entity or array of entities from the database
	 *
	 * @entity The entity or array of entities to refresh
	 */
	BaseORMService function refresh( required any entity ){
		var aObjects = isArray( arguments.entity ) ? arguments.entity : [ arguments.entity ];

		for ( var item in aObjects ) {
			entityReload( item );
		}

		return this;
	}

	/**
	 * Get an array of properties that are dirty in the entity, empty array if none or if the entity is not in session.
	 *
	 * @entity The entity to check
	 */
	array function getDirtyPropertyNames( required entity ){
		return entityGetDirtyProperties( arguments.entity );
	}

	/**
	 * Verifies if the entity has dirty data or not.
	 *
	 * @entity The entity to check
	 */
	boolean function isDirty( required entity ){
		return entityIsDirty( arguments.entity );
	}

	/**
	 * Get the unique identifier value for the passed in entity, or null if it has none yet
	 *
	 * @entity The entity to inspect for it's id
	 */
	any function getKeyValue( required entity ){
		try {
			return entityGetId( arguments.entity );
		} catch ( any e ) {
			return;
		}
	}

	/**
	 * Returns the key (id field) of a given entity, either simple or composite keys.
	 * If the key is a simple pk then it will return a string, if it is a composite key then it returns an array.
	 * If the key cannot be identified then a blank string is returned.
	 *
	 * @entity The entity name or entity object
	 *
	 * @return string or array
	 */
	any function getKey( required entity ){
		var idProperties = entityGetMetadata( arguments.entity ).idProperties;

		// Is this a simple key?
		if ( idProperties.len() == 1 ) {
			return idProperties[ 1 ];
		}

		// Composite Keys?
		if ( idProperties.len() > 1 ) {
			return idProperties;
		}

		return "";
	}

	/**
	 * Returns the Property Names of the entity via the entity metadata
	 *
	 * @entity The entity name or the actual entity object
	 */
	array function getPropertyNames( required entity ){
		return entityGetMetadata( arguments.entity ).propertyNames;
	}

	/**
	 * Returns the table name that the current entity belongs to via the entity metadata
	 *
	 * @entity The entity name or the actual entity object
	 */
	string function getTableName( required entity ){
		return entityGetMetadata( arguments.entity ).tableName;
	}

	/**
	 * Get an entity's Hibernate metadata: its entity persister, which has the Hibernate 5 `ClassMetadata` methods
	 * (`getPropertyNames()`, `getPropertyTypes()`, `hasIdentifierProperty()`, `getIdentifierPropertyName()`,
	 * `getIdentifierType()`, ...). For a BoxLang struct of the same information use `entityGetMetadata()`.
	 *
	 * @see    https://docs.jboss.org/hibernate/orm/7.0/javadocs/org/hibernate/persister/entity/EntityPersister.html
	 * @entity The entity name or entity object
	 *
	 * @return The Hibernate EntityPersister
	 */
	function getEntityMetadata( required entity ){
		var entityName = isObject( arguments.entity ) ? entityGetName( arguments.entity ) : arguments.entity;
		return ormGetSessionFactory( entityGetDatasource( entityName ) )
			.getMappingMetamodel()
			.getEntityDescriptor( entityName );
	}

	/**
	 * Returns the entity name from a given entity object
	 *
	 * @entity The entity to get it's name from
	 *
	 * @return The entity name
	 */
	function getEntityGivenName( required entity ){
		return entityGetName( arguments.entity );
	}

	/*****************************************************************************************/
	/********************************* DELETION METHODS ************************************/
	/*****************************************************************************************/

	/**
	 * Delete an entity. The entity argument can be a single entity
	 * or an array of entities. You can optionally flush the session also after committing
	 * Transactions are used if useTransactions bit is set or the transactional argument is passed
	 *
	 * @entity        The entity or array of entities to delete
	 * @flush         Do a flush after deleting, false by default since we use transactions
	 * @transactional Wrap it in a `transaction`, defaults to true
	 */
	BaseORMService function delete(
		required any entity,
		boolean flush         = false,
		boolean transactional = getUseTransactions()
	){
		return $transactioned(
			function( entity, flush ){
				// bx-orm deletes an array too, and flushes every datasource it touched
				entityDelete( arguments.entity, { "flush" : arguments.flush } );
				return this;
			},
			arguments,
			arguments.transactional
		);
	}

	/**
	 * Delete all entries for an entity DLM style and transaction safe. It also returns all the count of deletions
	 * Transactions are used if useTransactions bit is set or the transactional argument is passed
	 *
	 * @entityName    The entity name to delete all from
	 * @flush         Do a flush after deleting, false by default since we use transactions
	 * @transactional Wrap it in a `transaction`, defaults to true
	 */
	numeric function deleteAll(
		required string entityName,
		boolean flush         = false,
		boolean transactional = getUseTransactions()
	){
		return $transactioned(
			function( entityName, flush ){
				// A bulk delete: pending changes are flushed first, and a softDelete entity is marked deleted
				var count = entityCriteria( arguments.entityName ).deleteAll();

				// Auto Flush
				if ( arguments.flush ) {
					flushDatasource( entityGetDatasource( arguments.entityName ) );
				}

				return count;
			},
			arguments,
			arguments.transactional
		);
	}

	/**
	 * Delete using an entity name and an id, you can also flush the session if needed.
	 * Please note that this runs an HQL bulk delete operations so no cascades will take effect.  If you want cascades to occur
	 * then use the `delete()` operation instead.
	 * The id parameter can be a single id or an array of IDs to delete
	 * The method returns the count of deleted entities.
	 * Transactions are used if useTransactions bit is set or the transactional argument is passed
	 *
	 * @entityName    The entity name target
	 * @id            The single id or an array of Ids to delete
	 * @flush         Do a flush after deleting, false by default since we use transactions
	 * @transactional Wrap it in a `transaction`, defaults to true
	 */
	numeric function deleteByID(
		required string entityName,
		required any id,
		boolean flush         = false,
		boolean transactional = getUseTransactions()
	){
		return $transactioned(
			function( entityName, id, flush ){
				// A bulk delete: pending changes are flushed first; composite ids are matched on every key property
				var count = whereIds( entityCriteria( arguments.entityName ), arguments.entityName, arguments.id ).deleteAll();

				// Auto Flush
				if ( arguments.flush ) {
					flushDatasource( entityGetDatasource( arguments.entityName ) );
				}

				return count;
			},
			arguments,
			arguments.transactional
		);
	}

	/**
	 * Delete using HQL native queries. Do not add the `delete` keyword, this is added automatically for you.
	 *
	 * So you can do <code>deleteByQuery( "from categories where id = :id" )</code>
	 *
	 * @query         The query to use for deletion
	 * @params        The params to bind the query with
	 * @flush         Do a flush after deleting, false by default since we use transactions
	 * @transactional Wrap it in a `transaction`, defaults to true
	 * @datasource    Add the datasource to use or defaults
	 */
	numeric function deleteByQuery(
		required string query,
		any params            = {},
		boolean flush         = false,
		boolean transactional = getUseTransactions(),
		string datasource     = getDatasource()
	){
		return $transactioned(
			function( query, params, flush, datasource ){
				// Bulk Execute
				var count = ormExecuteQuery(
					"delete #arguments.query#",
					arguments.params,
					false,
					datasourceOptions( arguments.datasource )
				);

				// Auto Flush
				if ( arguments.flush ) {
					flushDatasource( arguments.datasource );
				}

				return count;
			},
			arguments,
			arguments.transactional
		);
	}

	/**
	 * Deletes entities by using name value pairs as arguments to this function.
	 * One mandatory argument is to pass the 'entityName'.
	 * The rest of the arguments are used in the where class using <strong>AND</strong> notation and parameterized.
	 *
	 * Ex:
	 * <pre>
	 * deleteWhere(entityName="User",age="4",isActive=true);
	 * </pre>
	 *
	 * @entityName    The entity name to target
	 * @flush         Do a flush after deleting, false by default since we use transactions
	 * @transactional Wrap it in a `transaction`, defaults to true
	 * @datasource    The datasource to use or the default one
	 */
	numeric function deleteWhere(
		required string entityName,
		boolean flush         = false,
		boolean transactional = getUseTransactions(),
		datasource            = getDatasource()
	){
		return $transactioned(
			function( entityName, flush, datasource ){
				// The name-value pairs, without the reserved names
				var filter = whereArguments( arguments, "entityName,flush,datasource" );

				// Do we have arguments?
				if ( filter.isEmpty() ) {
					throw(
						message = "No where arguments sent, aborting deletion",
						detail  = "We will not do a full delete via this method, you need to pass in named value arguments.",
						type    = "BaseORMService.NoWhereArgumentsFound"
					);
				}

				// A bulk delete: each key is validated as a property, and pending changes are flushed first
				var count = entityCriteria( arguments.entityName ).where( filter ).deleteAll();

				// Auto Flush
				if ( arguments.flush ) {
					flushDatasource( entityGetDatasource( arguments.entityName ) );
				}

				return count;
			},
			arguments,
			arguments.transactional
		);
	}

	/**
	 * Update the entities matching a criteria structure with one bulk HQL update, and return how many were updated.
	 * It runs in the database only: no entity events, no cascades, and entities already in the session keep their old
	 * values until reloaded.
	 *
	 * Ex:
	 * <pre>
	 * updateWhere( "User", { isActive : false }, { isArchived : true } );
	 * </pre>
	 *
	 * @entityName    The entity name to target
	 * @criteria      The property values to match; it cannot be empty
	 * @values        The property values to set
	 * @transactional Wrap it in a `transaction`, defaults to true
	 *
	 * @return The number of updated rows
	 */
	numeric function updateWhere(
		required string entityName,
		required struct criteria,
		required struct values,
		boolean transactional = getUseTransactions()
	){
		if ( arguments.criteria.isEmpty() ) {
			throw(
				message = "No criteria sent, aborting the update",
				detail  = "We will not update every row via this method: pass the property values to match, or use entityCriteria().updateAll().",
				type    = "BaseORMService.NoWhereArgumentsFound"
			);
		}
		return $transactioned(
			function( entityName, criteria, values ){
				return entityCriteria( arguments.entityName ).where( arguments.criteria ).updateAll( arguments.values );
			},
			arguments,
			arguments.transactional
		);
	}

	/*****************************************************************************************/
	/********************************* SAVE METHODS ******************************************/
	/*****************************************************************************************/

	/**
	 * Saves an array of passed entities in specified order in a single transaction block
	 *
	 * @entities      An array of entities to save
	 * @forceInsert   Defaults to false, but if true, will insert as new record regardless
	 * @flush         Do a flush after saving the entries, false by default since we use transactions
	 * @transactional Wrap it in a `transaction`, defaults to true
	 */
	BaseORMService function saveAll(
		required entities,
		forceInsert           = false,
		boolean flush         = false,
		boolean transactional = getUseTransactions()
	){
		return $transactioned(
			function( entities, forceInsert, flush ){
				var eventHandling = getEventHandling();

				// iterate and save
				for ( var thisEntity in arguments.entities ) {
					// Event Handling? If enabled, call the preSave() interception
					if ( eventHandling ) {
						getORMEventHandler().preSave( thisEntity );
					}

					// Save it
					entitySave( thisEntity, arguments.forceInsert );

					// Event Handling? If enabled, call the postSave() interception
					if ( eventHandling ) {
						getORMEventHandler().postSave( thisEntity );
					}
				}

				// Auto Flush: every datasource the entities belong to
				if ( arguments.flush ) {
					var datasources = {};
					for ( var thisEntity in arguments.entities ) {
						datasources[ entityGetDatasource( thisEntity ) ] = true;
					}
					for ( var datasource in datasources ) {
						flushDatasource( datasource );
					}
				}

				return this;
			},
			arguments,
			arguments.transactional
		);
	}

	/**
	 * Save an entity using transactions or not. You can optionally flush the session also
	 *
	 * @entity        The entity to save
	 * @forceInsert   Defaults to false, but if true, will insert as new record regardless
	 * @flush         Do a flush after saving the entity, false by default since we use transactions
	 * @transactional Wrap it in a `transaction`, defaults to true
	 *
	 * @return saved entity or array of entities
	 */
	any function save(
		required any entity,
		boolean forceInsert   = false,
		boolean flush         = false,
		boolean transactional = getUseTransactions()
	){
		return $transactioned(
			function( entity, forceInsert, flush ){
				// Event handling flag
				var eventHandling = getEventHandling();

				// Event Handling? If enabled, call the preSave() interception
				if ( eventHandling ) {
					getORMEventHandler().preSave( arguments.entity );
				}

				// save, flushing the entity's datasource when asked
				entitySave(
					arguments.entity,
					arguments.forceInsert,
					{ "flush" : arguments.flush }
				);

				// Event Handling? If enabled, call the postSave() interception
				if ( eventHandling ) {
					getORMEventHandler().postSave( arguments.entity );
				}

				return arguments.entity;
			},
			arguments,
			arguments.transactional
		);
	}

	/*****************************************************************************************/
	/********************************* COUNTER METHODS ***************************************/
	/*****************************************************************************************/

	/**
	 * Checks if the given entityName and id exists in the database, this method does not load the entity into session
	 *
	 * @entityName The name of the entity
	 * @id         The id to lookup, or a struct of key values for a composite id
	 */
	boolean function exists( required entityName, required any id ){
		// An EXISTS query that stops at the first row; a composite id is a struct of its key values
		return entityCriteria( arguments.entityName ).idEq( arguments.id ).exists();
	}

	/**
	 * Return the count of records in the DB for the given entity name. You can also pass an optional where statement
	 * that can filter the count. Ex: <code>count( 'User','age > 40 AND name="joe"' )</code>. You can even use params with this method:
	 * Ex: <code>count('User','age > ?1 AND name = ?2',[40,"joe"])</code>
	 *
	 * @entityName The name of the entity
	 * @where      The HQL where statement
	 * @params     Any params to bind in the where argument
	 */
	numeric function count(
		required string entityName,
		string where = "",
		any params   = structNew()
	){
		var hql     = "select count(*) from #arguments.entityName#";
		var options = { "datasource" : entityGetDatasource( arguments.entityName ) };

		// Caching?
		if ( getUseQueryCaching() ) {
			options.cacheName = getQueryCacheRegion();
			options.cacheable = true;
		}

		// build params
		if ( len( trim( arguments.where ) ) ) {
			hql &= " WHERE #trim( arguments.where )#";
		}

		// execute query as unique for the count
		return ormExecuteQuery( hql, arguments.params, true, options );
	}

	/**
	 * Returns the count by passing name value pairs as arguments to this function.  One mandatory argument is to pass the 'entityName'.
	 * The rest of the arguments are used in the where class using AND notation and parameterized.
	 * Ex: <code>countWhere( entityName="User", age="20" );</code>
	 *
	 * @entityName The entity name to count on
	 */
	numeric function countWhere( required string entityName ){
		// Each key is validated as a property of the entity
		var c = entityCriteria( arguments.entityName ).where( whereArguments( arguments, "entityName" ) );

		// Caching?
		if ( getUseQueryCaching() ) {
			c.cache( true, getQueryCacheRegion() );
		}

		return c.count();
	}

	/*****************************************************************************************/
	/********************************* EVICTION METHODS **************************************/
	/*****************************************************************************************/

	/**
	 * Evict all the collection or association data for a given entity name and collection name from the secondary cache ONLY, not the hibernate session
	 * Evict an entity name with or without an ID from the secondary cache ONLY, not the hibernate session
	 *
	 * @entityName   The entity name to evict or use in the eviction process
	 * @relationName The name of the relation in the entity to evict
	 * @id           The id to use for eviction according to entity name or relation name
	 */
	any function evictCollection(
		required string entityName,
		string relationName,
		any id
	){
		// With Relation
		if ( !isNull( arguments.relationName ) ) {
			if ( !isNull( arguments.id ) ) {
				ormEvictCollection(
					arguments.entityName,
					arguments.relationName,
					arguments.id
				);
			} else {
				ormEvictCollection( arguments.entityName, arguments.relationName );
			}

			return this;
		}

		// Single Entity
		if ( !isNull( arguments.id ) ) {
			ormEvictEntity( arguments.entityName, arguments.id );
		} else {
			ormEvictEntity( arguments.entityName );
		}

		return this;
	}

	/**
	 * Evict entity object(s) from the hibernate session or first-level cache
	 *
	 * 1) An entity object
	 * 2) An array of entity objects
	 *
	 * @entities The argument can be one persistence entity or an array of entities to evict
	 */
	BaseORMService function evict( required any entities ){
		var objects = isArray( arguments.entities ) ? arguments.entities : [ arguments.entities ];

		for ( var item in objects ) {
			entityEvict( item );
		}

		return this;
	}

	/**
	 * Evict all queries in the default cache or the cache region passed
	 *
	 * @cacheName  The cache region to evict from or if empty from the default cache region
	 * @datasource The specific datasource to use or the default datasource
	 */
	BaseORMService function evictQueries( string cacheName, string datasource = getDatasource() ){
		if ( isNull( arguments.cacheName ) || !len( arguments.cacheName ) ) {
			ormEvictQueries( datasource = arguments.datasource );
		} else {
			ormEvictQueries( arguments.cacheName, arguments.datasource );
		}
		return this;
	}

	/*****************************************************************************************/
	/********************************* ORM UTILITIES *****************************************/
	/*****************************************************************************************/

	/**
	 * Clear the session removes all the entities that are loaded or created in the session.
	 * This clears the first level cache and removes the objects that are not yet saved to the database.
	 *
	 * @datasource The datasource to use
	 */
	BaseORMService function clear( string datasource = getDatasource() ){
		if ( len( arguments.datasource ) ) {
			ormClearSession( arguments.datasource );
		} else {
			ormClearSession();
		}
		return this;
	}

	/**
	 * Checks if the hibernate session contains dirty objects that are awaiting persistence
	 *
	 * @datasource The datasource to use
	 */
	boolean function isSessionDirty( string datasource = getDatasource() ){
		return len( arguments.datasource ) ? ormIsSessionDirty( arguments.datasource ) : ormIsSessionDirty();
	}

	/**
	 * Checks if the current hibernate session contains the passed in entity.
	 *
	 * @entity The entity object
	 */
	boolean function sessionContains( required any entity ){
		return entityIsAttached( arguments.entity );
	}

	/**
	 * Information about the first-level (session) cache for the current session: collectionCount, collectionKeys,
	 * entityCount and entityKeys
	 *
	 * @datasource The datasource to use
	 */
	struct function getSessionStatistics( string datasource = getDatasource() ){
		return len( arguments.datasource ) ? ormGetSessionStatistics( arguments.datasource ) : ormGetSessionStatistics();
	}

	/**
	 * This method listens to non-existent method to create fluently:
	 *
	 * 1) FindByXXX operations
	 * 2) FindAllByXXX operations
	 * 3) countByXXX operations
	 *
	 * You can pass in the arguments a structure of options by calling it `options` or the last
	 * argument which is a struct will be used.  Options can contain the following keys:
	 *
	 * - ignoreCase:boolean (false)
	 * - maxResults:numeric (0)
	 * - offset:numeric (0)
	 * - cacheable:boolean (false)
	 * - cacheName:string ("default")
	 * - timeout:numeric (0=no timeout)
	 * - datasource:string (default datasource)
	 * - sortBy:hql (empty)
	 * - asStream:boolean (false)
	 *
	 * Else it throws a method does not exist exception
	 *
	 * @missingMethodName      The method called
	 * @missingMethodArguments The arguments it was called with
	 *
	 * @throws MissingMethodException
	 */
	any function onMissingMethod( string missingMethodName, struct missingMethodArguments ){
		var method = arguments.missingMethodName;
		var args   = arguments.missingMethodArguments;

		// Dynamic Find Unique Finders
		if ( left( method, 6 ) eq "findBy" and len( method ) GT 6 ) {
			return getDynamicProcessor().process(
				method     = right( method, len( method ) - 6 ),
				args       = args,
				unique     = true,
				ormService = this
			);
		}
		// Dynamic find All Finders
		if ( left( method, 9 ) eq "findAllBy" and len( method ) GT 9 ) {
			return getDynamicProcessor().process(
				method     = right( method, len( method ) - 9 ),
				args       = args,
				unique     = false,
				ormService = this
			);
		}
		// Dynamic countBy Finders
		if ( left( method, 7 ) eq "countBy" and len( method ) GT 7 ) {
			return getDynamicProcessor().process(
				method     = right( method, len( method ) - 7 ),
				args       = args,
				unique     = true,
				isCounting = true,
				ormService = this
			);
		}

		// Throw exception, method not found.
		throw(
			message = "Invalid method call: #arguments.missingMethodName#",
			detail  = "The method you called does not exist in this component",
			type    = "MissingMethodException"
		);
	}

	/*****************************************************************************************/
	/********************************* CRITERIA METHODS **************************************/
	/*****************************************************************************************/

	/**
	 * Get the restrictions builder: its methods build conditions (`isEq`, `like`, `or`, ...) to pass to a criteria's
	 * `add()`, `or()`, `and()` and `not()`. It is the same object as a criteria's `c.restrictions`.
	 *
	 * @entityName The entity to take the restrictions from; any mapped entity works, they are not tied to it
	 *
	 * @return The bx-orm criteria restrictions helper
	 */
	function getRestrictions( string entityName = "" ){
		if ( !len( arguments.entityName ) ) {
			var names = entityNameArray();
			if ( !names.len() ) {
				throw(
					message = "There are no ORM entities to build restrictions for",
					type    = "BaseORMService.NoEntitiesFound"
				);
			}
			arguments.entityName = names[ 1 ];
		}
		return entityCriteria( arguments.entityName ).restrictions;
	}

	/**
	 * Get a brand new criteria builder object: a bx-orm `entityCriteria()`
	 *
	 * @entityName       The name of the entity to bind this criteria query to
	 * @useQueryCaching  Activate query caching for the list operations
	 * @queryCacheRegion The query cache region to use, which defaults to criterias.{entityName}
	 * @datasource       Ignored: the criteria runs on the entity's own datasource
	 *
	 * @return The bx-orm criteria builder
	 */
	any function newCriteria(
		required string entityName,
		boolean useQueryCaching = false,
		string queryCacheRegion = "",
		datasource              = getDatasource()
	){
		var criteria = entityCriteria( arguments.entityName );

		if ( arguments.useQueryCaching ) {
			criteria.cache(
				true,
				len( trim( arguments.queryCacheRegion ) ) ? arguments.queryCacheRegion : "criterias.#arguments.entityName#"
			);
		}

		return criteria;
	}

	/*****************************************************************************************/
	/********************************* PRIVATE METHODS **************************************/
	/*****************************************************************************************/

	/**
	 * The offset, max rows and timeout query options, leaving out the zero (unset) ones, plus query caching when the
	 * service uses it
	 *
	 * @offset  Rows to skip
	 * @max     Maximum rows, 0 for all
	 * @timeout Timeout in seconds, 0 for none
	 *
	 * @return The options struct
	 */
	private struct function pagingOptions(
		numeric offset  = 0,
		numeric max     = 0,
		numeric timeout = 0
	){
		var options = {};
		if ( arguments.offset != 0 ) {
			options.offset = arguments.offset;
		}
		if ( arguments.max != 0 ) {
			options.maxresults = arguments.max;
		}
		if ( arguments.timeout != 0 ) {
			options.timeout = arguments.timeout;
		}
		if ( getUseQueryCaching() ) {
			options.cacheName = getQueryCacheRegion();
			options.cacheable = true;
		}
		return options;
	}

	/**
	 * Normalize an id, a list of ids or an array of ids into an array of ids
	 *
	 * @id The id, list of ids or array of ids
	 *
	 * @return An array of ids
	 */
	private array function idArray( required id ){
		if ( isSimpleValue( arguments.id ) ) {
			return listToArray( arguments.id );
		}
		return isArray( arguments.id ) ? arguments.id : [ arguments.id ];
	}

	/**
	 * The name of an entity's id property; an entity with a composite id is an error for this operation
	 *
	 * @entityName The entity name
	 * @operation  The operation, for the error message
	 *
	 * @return The id property name
	 */
	private string function singleIdProperty( required entityName, required operation ){
		var idProperties = entityGetMetadata( arguments.entityName ).idProperties;
		if ( idProperties.len() != 1 ) {
			throw(
				message = "#arguments.operation# needs an entity with a single id property, but #arguments.entityName# has a composite id",
				type    = "BaseORMService.CompositeIdNotSupported"
			);
		}
		return idProperties[ 1 ];
	}

	/**
	 * Match a criteria on one or more ids: an id, a list or array of ids, or, for a composite id, a struct or an array of
	 * structs of key values
	 *
	 * @criteria   The bx-orm criteria
	 * @entityName The entity name
	 * @id         The id(s)
	 *
	 * @return The criteria
	 */
	private function whereIds(
		required criteria,
		required entityName,
		required id
	){
		var idProperties = entityGetMetadata( arguments.entityName ).idProperties;
		if ( idProperties.len() == 1 ) {
			return arguments.criteria.isIn( idProperties[ 1 ], idArray( arguments.id ) );
		}
		// Composite id: any of the key-value structs
		var ids = isArray( arguments.id ) ? arguments.id : [ arguments.id ];
		return arguments.criteria.anyOf( ( c ) => {
			for ( var thisId in ids ) {
				c.idEq( thisId );
			}
		} );
	}

	/**
	 * The name-value pairs passed to a method like `countWhere( entityName = "User", age = 20 )`: every argument except
	 * the reserved ones and the ones not given
	 *
	 * @args     The method's arguments scope
	 * @reserved The reserved argument names, as a list
	 *
	 * @return The property filter struct
	 */
	private struct function whereArguments( required args, required string reserved ){
		var filter = {};
		for ( var key in arguments.args ) {
			if ( listFindNoCase( arguments.reserved, key ) || isNull( arguments.args[ key ] ) ) {
				continue;
			}
			filter[ key ] = arguments.args[ key ];
		}
		return filter;
	}

	/**
	 * Query options with the datasource, when one is given
	 *
	 * @datasource The datasource name or an empty string
	 */
	private struct function datasourceOptions( datasource = "" ){
		return len( arguments.datasource ) ? { "datasource" : arguments.datasource } : {};
	}

	/**
	 * Flush a datasource's session, or the default one
	 *
	 * @datasource The datasource name or an empty string
	 */
	private function flushDatasource( datasource = "" ){
		if ( len( arguments.datasource ) ) {
			ormFlush( arguments.datasource );
		} else {
			ormFlush();
		}
	}

	/**
	 * Run a closure inside a BoxLang transaction, unless one is already running (the ORM rides the transaction's
	 * connection, so ORM writes commit and roll back with it)
	 *
	 * @target        The closure or UDF to execute
	 * @argCollection The arguments
	 * @transactional Whether to apply the transactions or not.
	 */
	private any function $transactioned(
		required target,
		argCollection         = {},
		boolean transactional = getUseTransactions()
	){
		// Clean up the arg collection
		structDelete( arguments.argCollection, "transactional" );

		// Already in a transaction (it commits or rolls back this work too), or not wanted: just run it
		if ( !arguments.transactional || isInTransaction() ) {
			return arguments.target( argumentCollection = arguments.argCollection );
		}

		// BoxLang commits at the end, and rolls back and rethrows when the target throws
		var results = null;
		transaction {
			results = arguments.target( argumentCollection = arguments.argCollection );
		}
		// With CFML null semantics a null result removes the variable
		if ( !isNull( results ) ) {
			return results;
		}
	}

}
